# Copy this file to `server/.env` and fill in ONE of the two mail setups
# below, then run the mail API with `npm run server` (in a second terminal,
# alongside `npm run dev`).

# Where Comm_Link submissions are delivered.
CONTACT_TO_EMAIL=bhavesh.sabnani2005@gmail.com

# Comma-separated list of origins allowed to call this API directly. Not
# needed in local dev (Vite proxies /api to this server), but required if you
# deploy the frontend and this API to different origins.
CORS_ORIGIN=http://localhost:5173

# Port this API listens on.
PORT=4001

# ---- Option 1: Gmail with an App Password (simplest for a Gmail inbox) ----
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces are fine, they're ignored)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Option 2: Any SMTP provider (SendGrid, Mailgun, Zoho, your host, ...) -
# Only fill these in if you are NOT using the Gmail option above.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
